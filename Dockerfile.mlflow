# MLflow tracking server with deps baked in (the original compose ran
# apt-get + pip install on EVERY container start).
FROM python:3.11-slim AS builder
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
# sqlalchemy pinned: MLflow 2.17 crashes with SQLAlchemy 2.1
RUN pip install "mlflow==2.17.2" "sqlalchemy==2.0.36"

FROM python:3.11-slim AS runtime
ENV PATH="/opt/venv/bin:$PATH" PYTHONUNBUFFERED=1
COPY --from=builder /opt/venv /opt/venv
RUN mkdir -p /mlflow/db /mlflow/artifacts
EXPOSE 5000
CMD ["mlflow", "server", \
     "--backend-store-uri", "sqlite:////mlflow/db/mlflow.db", \
     "--artifacts-destination", "/mlflow/artifacts", \
     "--serve-artifacts", \
     "--host", "0.0.0.0", "--port", "5000"]
